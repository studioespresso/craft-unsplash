{% import '_includes/forms' as forms %}
<form action="{{ cpUrl('splashing-images/search') }}" method="get" class="splashing-search flex gap-2 items-center">
    {{ forms.text({
        type: 'search',
        name: 'search',
        value: query ?? '',
        placeholder: 'Search'|t('app'),
    }) }}
    <craft-button type="submit">{{ 'Search'|t('app') }}</craft-button>
</form>
