<div class="cp-container">
<div id="splashing-container" class="splashing-container are-images-unloaded">
    <div class="splashing-image-sizer"></div>
    {% for image in data.images %}
        <div class="splashing-image-grid">
            <button type="button" class="splashing-image js-splashing-image" data-id="{{ image.id }}" title="{{ 'Save to Assets'|t('splashing-images') }}">
                <img src="{{ image.small }}" alt="{{ 'Photo by {name}'|t('splashing-images', { name: image.attr.name }) }}">
            </button>
            <craft-spinner class="splashing-spinner"></craft-spinner>
            <a class="splashing-attribute" href="{{ image.attr.link }}" target="_blank" rel="noopener">{{ image.attr.name }}</a>
        </div>
    {% endfor %}
</div>
{% if data.next_page is defined %}
    <div class="pagination">
        <a href="{{ url(data.next_page) }}" class="js-pagination__next">{{ 'Next'|t }}</a>
    </div>
    <div class="page-load-status" style="display: none;">
        <craft-spinner class="infinite-scroll-request">{{ 'Loading…'|t('app') }}</craft-spinner>
        <p class="infinite-scroll-last">{{ 'End of content'|t('splashing-images') }}</p>
        <p class="infinite-scroll-error">{{ 'No more pages to load'|t('splashing-images') }}</p>
    </div>
{% endif %}
</div>
